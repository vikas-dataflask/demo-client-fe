import React, { useState, useEffect } from "react";

import { ReloadIcon } from "../../icons/ReloadIcon";
import EyeIcon from "../../icons/EyeIcon";
import EyeCloseIcon from "../../icons/EyeCloseIcon";
import SearchIcon from "../../icons/SearchIcon";
import attributeMapping from "./attributeMapping"; // Ensure this import is correct

// Service → bases mapping (duplicated for helper functions' scope within this file for self-containment)
const serviceLayers = {
  HVAC: ["CEILING SUSPENDED UNIT", "SPLIT UNIT", "CASSETTE UNIT", "OUTDOOR"],
  ELECTRICAL: ["DISTRIBUTION BOARDS", "LED BATTEN", "LED BULKHEAD"],
  "FIRE FIGHTING": [
    "HYDRANT MAIN FIRE PUMP",
    "JOCKEY PUMP",
    "PORTABLE FIRE EXTINGUISHERS",
  ],
  PLUMBING: ["BUTTERFLY VALVE", "NON RETURN VALVE"],
};

// “All” flattens every base once (duplicated for helper functions' scope within this file for self-containment)
const allBases = Array.from(new Set(Object.values(serviceLayers).flat()));

// Helper to get base name from full layer name
const getBaseNameFromLayer = (fullLayerName, currentService) => {
  if (!fullLayerName) return null;

  const basesToCheck =
    currentService === "All" ? allBases : serviceLayers[currentService] || [];

  for (const base of basesToCheck) {
    if (fullLayerName.toUpperCase().startsWith(base.toUpperCase())) {
      return base;
    }
  }
  return null;
};

// Helper to get attribute definition (updated to return the entire attribute object including label and unit)
const getAttributesForLayerDefinition = (serviceType, heading) => {
  if (!heading) return null;

  if (serviceType === "All") {
    for (const svcKey in attributeMapping) {
      const serviceCategory = attributeMapping[svcKey];
      if (serviceCategory) {
        const match = serviceCategory.find((item) => item.heading === heading);
        if (match) {
          return match.attributes; // Returns { attributeKey: { label: "Label", unit: "Unit" }, ... }
        }
      }
    }
    return null;
  } else {
    const service = attributeMapping[serviceType];
    if (!service) return null;
    const match = service.find((item) => item.heading === heading);
    return match?.attributes || null; // Returns { attributeKey: { label: "Label", unit: "Unit" }, ... }
  }
};

export default function SidebarEQ({
  entities = [], // [{ layer: string, qty: number, base: string }] - now also includes base
  onLayerSelect, // Callback from QuantityExtraction for toggling selection
  selectedBase = [], // e.g. ['CEILING SUSPENDED UNIT'] - passed from parent to highlight checkboxes
  selectedService, // e.g. "All" or "ELECTRICAL"
  onServiceChange, // Setter from parent
  activeLayer, // e.g., "CASSETTE UNIT 2.5 TR" - passed from parent for currently active table row
  setActiveLayer, // Setter from parent for active layer (table click)
  onUpdateLayerAttributes, // Callback to update parent's table data (now triggered by save button)
  activeLayerData, // Full data for the currently active layer from QuantityExtraction
}) {
  const [activeTab, setActiveTab] = useState("property");
  const [search, setSearch] = useState("");

  // localActiveLayerData holds the editable data for the currently selected layer
  const [localActiveLayerData, setLocalActiveLayerData] = useState(null);

  // Sync local state with props when activeLayerData changes (item selected/deselected)
  useEffect(() => {
    // When activeLayerData changes, update the local editable copy
    if (activeLayerData) {
      setLocalActiveLayerData({
        ...activeLayerData,
        // Ensure attributes object is deeply copied to prevent direct mutation issues
        attributes: activeLayerData.attributes
          ? { ...activeLayerData.attributes }
          : {},
      });
    } else {
      setLocalActiveLayerData(null); // Clear local data if no active layer
    }
  }, [activeLayerData]);

  // Handler for all input changes (layerName, attributes, description, remark)
  const handleInputChange = (e) => {
    const { name, value } = e.target;

    setLocalActiveLayerData((prevData) => {
      if (!prevData) return prevData; // Should not happen if an item is active

      const newData = { ...prevData };

      if (name === "description" || name === "remark") {
        // layerName is now handled as an attribute
        newData[name] = value;
      } else {
        // Assume it's an attribute
        newData.attributes = {
          ...newData.attributes,
          [name]: {
            ...newData.attributes[name], // Preserve unit and other properties
            value: value,
          },
        };
      }
      return newData;
    });
  };

  // Handler for the "Save" button
  const handleSaveAttributes = () => {
    if (onUpdateLayerAttributes && localActiveLayerData) {
      console.log("SB: Save button clicked. Dispatching changes to parent.");
      // Pass the *original* layerName to identify the item, and the *updated* data
      onUpdateLayerAttributes(activeLayerData.layerName, {
        // layerName is now part of attributes
        description: localActiveLayerData.description,
        remark: localActiveLayerData.remark,
        attributes: localActiveLayerData.attributes,
      });
    } else {
      console.log(
        "SB: Cannot save, no active layer data or onUpdateLayerAttributes not available."
      );
    }
  };

  const [rawLayers, setRawLayers] = useState([]); // All unique layer names from entities
  const [layers, setLayers] = useState([]); // Filtered layers for display in sidebar list
  const [visibility, setVisibility] = useState({}); // Local state for eye icons

  // Effect to build and filter the list of layers displayed in the sidebar
  // This runs when `entities` (raw data) or `selectedService` changes
  useEffect(() => {
    console.log(
      "SB: Layers useEffect triggered. Selected Service:",
      selectedService
    );
    // Entities now include 'base'
    const allUniqueLayers = entities.map((e) => ({
      layer: e.layer,
      base: e.base,
    }));

    const foundBases = new Set();
    const basesForService =
      selectedService === "All"
        ? allBases
        : serviceLayers[selectedService] || [];

    // Filter `entities` to include only those relevant to the current `selectedService`
    // and then extract unique base names that are present in the data.
    const relevantEntities = entities.filter((entity) => {
      const baseName = getBaseNameFromLayer(entity.layer, selectedService);
      return baseName && basesForService.includes(baseName);
    });

    relevantEntities.forEach((entity) => {
      foundBases.add(entity.base);
    });

    const newLayerList = Array.from(foundBases).sort(); // Sort bases alphabetically
    const newLayers = newLayerList.map((name) => ({ name, color: "#FFA500" })); // Default color orange

    if (JSON.stringify(newLayers) !== JSON.stringify(layers)) {
      setLayers(newLayers);
    }

    // Initialize visibility state for new layers, preserving existing visibility
    const newVisibility = {};
    newLayerList.forEach((name) => {
      newVisibility[name] = visibility[name] ?? true; // Default to visible if not set
    });

    if (JSON.stringify(newVisibility) !== JSON.stringify(visibility)) {
      setVisibility(newVisibility);
    }
  }, [entities, selectedService, layers, visibility]); // Dependencies for this effect

  // Toggles the visibility state of a layer (for eye icon)
  const toggleVisibility = (name) => {
    console.log("SB: Toggling visibility for:", name);
    setVisibility((v) => ({ ...v, [name]: !v[name] }));
  };

  // Handles click on a layer name in the sidebar list (checkbox area)
  const handleClickLayer = (baseName) => {
    console.log("SB: handleClickLayer called for baseName:", baseName);
    if (onLayerSelect) {
      onLayerSelect(baseName); // Call the parent's handler to update its 'selected' state
    }
    // No longer setting activeLayer here, it comes from parent via activeLayer prop
  };

  // Filters the layers list based on search input
  const filteredBases = layers.filter((l) =>
    l.name.toLowerCase().includes(search.toLowerCase())
  );

  return (
    <div className="w-[320px] h-full bg-white shadow-md border border-[#E5E7EB] flex flex-col rounded-[12px]">
      {/* Header */}
      <div className="px-4 pt-4 pb-2 sticky top-0 z-30 bg-white border-b border-[#E5E7EB]">
        <div className="flex justify-between items-start">
          <div>
            <p className="text-[16px] font-semibold">Extract Quantities</p>
            <p className="text-[12px] text-[#6B7280]">Updated: Just now</p>
          </div>
          <button
            className="w-[24px] h-[24px] bg-[#0083EE] text-white hover:bg-sky-600 rounded-md flex items-center justify-center transition"
            onClick={() => console.log("Reload clicked")}
          >
            <ReloadIcon className="w-[16px] h-[16px] stroke-white" />
          </button>
        </div>
      </div>

      {/* Main scrollable area of the sidebar */}
      <div className="flex-1 overflow-y-auto">
        <div className="px-4 space-y-4 pb-4 bg-white">
          {/* Service Type Dropdown */}
          <div>
            <p className="text-[12px] font-medium text-[#6B7280] mb-1">
              Service Type:
            </p>
            <select
              className="text-[14px] px-3 py-2 border border-[#D1D5DB] rounded-[8px] w-full"
              value={selectedService}
              onChange={(e) => {
                console.log("SB: Service dropdown changed to:", e.target.value);
                onServiceChange(e.target.value); // Call parent's setter
              }}
            >
              <option value="All">All</option>
              {Object.keys(serviceLayers).map((service) => (
                <option key={service} value={service}>
                  {service}
                </option>
              ))}
            </select>
          </div>

          {/* Layers List */}
          <div>
            <p className="text-[14px] font-medium mb-2">Layers</p>
            <div className="flex items-center px-3 py-1.5 mb-2 border border-[#D1D5DB] rounded-[6px] bg-white">
              <SearchIcon className="w-4 h-4 text-[#6B7280]" />
              <input
                type="text"
                placeholder="Search"
                value={search}
                onChange={(e) => setSearch(e.target.value)}
                className="flex-1 ml-2 text-[13px] placeholder-[#6B7280] focus:outline-none"
              />
            </div>
            <div className="space-y-1">
              {filteredBases.map(
                (
                  base // Iterate over filtered bases
                ) => (
                  <div key={base.name}>
                    <div
                      className={`flex items-center justify-between px-2 py-2 rounded-[6px] cursor-pointer ${
                        selectedBase.includes(base.name)
                          ? "bg-[#E8EDF9]"
                          : "hover:bg-gray-100"
                      }`}
                      onClick={() => handleClickLayer(base.name)}
                    >
                      <div className="flex items-center gap-2">
                        <input
                          type="checkbox"
                          checked={selectedBase.includes(base.name)}
                          readOnly
                          className="accent-[#007AFF]"
                        />
                        <span className="text-[13px] font-semibold">
                          {base.name}
                        </span>
                      </div>
                      <div className="flex items-center gap-2">
                        {visibility[base.name] ? (
                          <EyeIcon
                            className="w-4 h-4 text-gray-500 cursor-pointer"
                            onClick={(e) => {
                              e.stopPropagation();
                              toggleVisibility(base.name);
                            }}
                          />
                        ) : (
                          <EyeCloseIcon
                            className="w-4 h-4 text-gray-400 cursor-pointer"
                            onClick={(e) => {
                              e.stopPropagation();
                              toggleVisibility(base.name);
                            }}
                          />
                        )}
                        <div
                          className="w-[10px] h-[10px] rounded-sm"
                          style={{ backgroundColor: base.color }}
                        />
                      </div>
                    </div>
                    {/* Now list actual layers under each base, filtered by search */}
                    <ul className="pl-6 text-sm">
                      {entities
                        .filter(
                          (e) =>
                            e.base === base.name &&
                            e.layer.toLowerCase().includes(search.toLowerCase())
                        )
                        .map((entity) => (
                          <li
                            key={entity.layer}
                            className={`cursor-pointer hover:bg-gray-50 px-2 py-1 rounded-[4px] ${
                              activeLayer === entity.layer
                                ? "bg-blue-100 font-medium"
                                : ""
                            }`}
                            onClick={() => setActiveLayer(entity.layer)} // Sets active layer for attribute panel
                          >
                            <span className="text-[13px] text-gray-700">
                              {entity.layer}
                            </span>
                            <span className="text-[12px] text-gray-500 ml-2">
                              ({entity.qty})
                            </span>
                          </li>
                        ))}
                    </ul>
                  </div>
                )
              )}
            </div>
          </div>
        </div>
      </div>

      {/* Bottom Panel (Property Details / Other Details) */}
      <div className="flex flex-col h-[360px] shrink-0 border-t border-[#E5E7EB] bg-white">
        {/* Tabs for Property / Other Details */}
        <div className="flex h-[40px]">
          <button
            className={`flex-1 text-[14px] font-medium ${
              activeTab === "property"
                ? "bg-[#007AFF] text-white"
                : "bg-white text-[#6B7280]"
            }`}
            onClick={() => setActiveTab("property")}
          >
            Property Details
          </button>
          <button
            className={`flex-1 text-[14px] font-medium ${
              activeTab === "other"
                ? "bg-[#007AFF] text-white"
                : "bg-white text-[#6B7280]"
            }`}
            onClick={() => setActiveTab("other")}
          >
            Other Details
          </button>
        </div>

        {/* Scrollable Content Area for Property/Other Details */}
        <div className="flex-1 overflow-y-auto px-4 pt-4 pb-20 space-y-4">
          {localActiveLayerData ? ( // Ensure localActiveLayerData is available
            <>
              {/* No separate Layer Name field here anymore, it's in Attributes */}

              {activeTab === "property" ? (
                <>
                  {/* Description Section */}
                  <div className="border border-[#D1D5DB] rounded-[8px] overflow-hidden">
                    <div className="bg-white px-3 py-2 border-b border-[#E5E7EB] text-[13px] font-medium">
                      Description
                    </div>
                    <textarea
                      rows={4}
                      name="description" // Essential for handleInputChange
                      value={localActiveLayerData.description || ""}
                      onChange={handleInputChange}
                      className="w-full px-3 py-2 text-[13px] text-[#374151] placeholder-[#6B7280] focus:outline-none resize-none"
                    />
                  </div>

                  {/* Attributes Section */}
                  <div className="border border-[#D1D5DB] rounded-[8px] overflow-hidden">
                    <div className="bg-white px-3 py-2 border-b border-[#E5E7EB] text-[13px] font-medium">
                      Attributes
                    </div>
                    <div className="px-3 py-3 space-y-4 text-[13px]">
                      {/* Dynamically render attributes based on the active layer's base */}
                      {getAttributesForLayerDefinition(
                        selectedService,
                        localActiveLayerData.base
                      ) ? (
                        Object.entries(
                          getAttributesForLayerDefinition(
                            selectedService,
                            localActiveLayerData.base
                          )
                        ).map(([key, attrDef]) => {
                          const currentAttribute = localActiveLayerData
                            .attributes[key] || {
                            value: "",
                            unit: attrDef.unit || "",
                          };

                          return (
                            <div
                              key={key}
                              className="flex items-center justify-between gap-4"
                            >
                              <span className="text-[#040c1a]">
                                {attrDef.label}
                              </span>
                              <div className="flex-1 flex items-center border border-[#D1D5DB] rounded-[6px] bg-white">
                                <input
                                  type="text"
                                  name={key} // Essential for handleInputChange
                                  value={currentAttribute.value}
                                  onChange={handleInputChange}
                                  placeholder="Value"
                                  className="flex-1 px-2 py-1 text-[13px] focus:outline-none rounded-l-[6px]"
                                />
                                {currentAttribute.unit && (
                                  <span className="px-2 py-1 text-[13px] bg-gray-50 border-l border-[#D1D5DB] rounded-r-[6px] text-gray-700">
                                    {currentAttribute.unit}
                                  </span>
                                )}
                              </div>
                            </div>
                          );
                        })
                      ) : (
                        <p className="text-[13px] text-gray-500">
                          No specific attributes defined for this layer type.
                        </p>
                      )}
                    </div>
                  </div>
                </>
              ) : (
                // Other Details (Remark) Section
                <div className="border border-[#D1D5DB] rounded-[8px] overflow-hidden">
                  <div className="bg-white px-3 py-2 border-b border-[#E5E7EB] text-[13px] font-medium">
                    Add Remark
                  </div>
                  <textarea
                    rows={4}
                    name="remark" // Essential for handleInputChange
                    placeholder="Enter remark here..."
                    value={localActiveLayerData.remark || ""}
                    onChange={handleInputChange}
                    className="w-full m-3 text-[13px] text-[#374151] placeholder-[#6B7280] focus:outline-none resize-none"
                  />
                </div>
              )}
            </>
          ) : (
            <p className="text-[14px] text-gray-500 p-4">
              Select an item from the list to view and edit its details.
            </p>
          )}
        </div>
        {/* Save Button at the bottom of the attribute section */}
        {localActiveLayerData && ( // Only show save button if a layer is active
          <div className="sticky bottom-0 w-full bg-white border-t border-gray-300 p-3 flex justify-end shadow">
            <button
              onClick={handleSaveAttributes}
              className="bg-[#007AFF] text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-blue-600 transition"
            >
              Save Changes
            </button>
          </div>
        )}
      </div>
    </div>
  );
}
